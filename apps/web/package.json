{
  "name": "@relacionamentos/web",
  "version": "0.1.0",
  "private": true,
  "description": "Frontend (quiz, resultado, checkout), API e painel administrativo em Next.js.",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
