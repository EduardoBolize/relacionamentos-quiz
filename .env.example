# ─────────────────────────────────────────────────────────────────────────────
# Copie este arquivo para `.env` e preencha os valores.
# NUNCA versione o `.env` (ele já está no .gitignore).
#
# Para gerar segredos aleatórios:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# ─────────────────────────────────────────────────────────────────────────────

# Banco de dados. Caminhos SQLite relativos são resolvidos a partir da raiz do projeto.
DATABASE_URL="file:./data/app.db"

# URL pública da aplicação (links enviados por e-mail e verificação de origem das requisições).
APP_URL="http://localhost:3000"

# Pagamentos: "mock" = gateway simulado (Pix, boleto e cartão de teste).
PAYMENT_PROVIDER="mock"
# Segredo usado para assinar/verificar webhooks de pagamento (mínimo 32 caracteres).
PAYMENT_WEBHOOK_SECRET=""
# Exibe os botões "Simular pagamento aprovado/recusado". Mantenha "false" em produção.
PAYMENT_SIMULATOR_ENABLED="true"

# E-mail: "outbox" (grava no banco e mostra no admin — apenas desenvolvimento) ou "console".
EMAIL_PROVIDER="outbox"

# Primeiro administrador (criado por `npm run db:seed` ou `npm run admin:create`).
# A senha precisa ter ao menos 12 caracteres.
ADMIN_EMAIL="admin@example.com"
ADMIN_NAME="Administrador"
ADMIN_PASSWORD=""

# Quantos proxies reversos confiáveis ficam na frente da aplicação (Nginx, Cloudflare, Vercel…).
# 0 = nenhum: o cabeçalho X-Forwarded-For é ignorado (ele pode ser forjado pelo cliente) e os limites de
# requisição usam outras chaves (sessão, e-mail) + um limite global de proteção.
# Com 1 proxy que ACRESCENTA o IP do cliente ao X-Forwarded-For, use 1.
TRUST_PROXY_HOPS="0"

# Em PRODUÇÃO a aplicação se recusa a iniciar com provedores de demonstração (PAYMENT_PROVIDER="mock" ou
# EMAIL_PROVIDER="outbox"), porque com eles qualquer pessoa libera conteúdo pago. Para uma demonstração
# pública consciente, descomente:
# ALLOW_DEMO_PROVIDERS="true"
